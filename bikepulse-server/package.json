{
    "name": "bikepulse-server",
    "version": "1.0.0",
    "description": "BikePulse: Real-time Shared Bike Status Detection and Prediction System",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "dev": "nodemon src/app.js",
        "logs": "tail -f ./logs/app.log",
        "seed:stations": "node scripts/seedStations.js",
        "redis:clear": "node scripts/clearCache.js",
        "test": "jest --detectOpenHandles",
        "test:watch": "jest --watch",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix"
    },
    "keywords": [
        "real-time",
        "bike-sharing",
        "prediction",
        "websocket",
        "mongodb",
        "redis",
        "event-driven"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.16.1",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "helmet": "^7.0.0",
        "joi": "^17.9.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^7.0.3",
        "morgan": "^1.10.0",
        "node-schedule": "^2.1.1",
        "nodemailer": "^8.0.9",
        "redis": "^4.6.5",
        "socket.io": "^4.6.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "eslint": "^8.43.0",
        "jest": "^29.5.0",
        "mongodb-memory-server": "^8.12.1",
        "nodemon": "^2.0.22",
        "prettier": "^2.8.8",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/your-repo/bikepulse-server.git"
    }
}
