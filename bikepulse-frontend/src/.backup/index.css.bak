:root {
  /* 🎨 Primary Palette */
  --primary: #00A651;        /* BikePulse Green */
  --primary-hover: #008f45;
  --primary-soft: #e6f6ee;
  --primary-glow: rgba(0, 166, 81, 0.15);
  
  --secondary: #10B981;      /* Emerald */
  --accent: #3B82F6;         /* Sophisticated Blue Accent */
  
  /* ⚪ Neutral Scale (Light Theme) */
  --bg-white: #FFFFFF;
  --bg-subtle: #F9FAFB;      /* Soft background */
  --bg-dark: #111827;        /* Used for dark text/elements */
  --bg-darker: #000000;
  
  --text-main: #111827;
  --text-muted: #6B7280;
  --text-inverse: #FFFFFF;
  
  --border-light: #F3F4F6;
  --border-main: #E5E7EB;
  --border-focus: var(--primary);
  
  /* 💎 Glass & Depth */
  --glass-bg: rgba(255, 255, 255, 0.75);
  --glass-border: rgba(255, 255, 255, 0.5);
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;

  --danger: #EF4444;
  --warning: #F59E0B;
  --success: #10B981;

  /* 🔗 Aliases for Backward Compatibility */
  --text: var(--text-main);
  --muted: var(--text-muted);
  --card-border: var(--border-main);
  --primary-2: var(--secondary);
}

/* 🏎️ Reset & Base */
*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text-main);
  font-family: 'Inter', 'Pretendard Variable', Pretendard, system-ui, -apple-system, sans-serif;
  background-color: var(--bg-subtle);
  background-image: 
    radial-gradient(at 0% 0%, hsla(150, 100%, 98%, 1) 0, transparent 50%), 
    radial-gradient(at 100% 0%, hsla(160, 100%, 98%, 1) 0, transparent 50%);
  background-attachment: fixed;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#root {
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s ease;
}

h1, h2, h3, h4, p {
  margin: 0;
}

/* 🧪 Layout Containers */
.app-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 24px 24px 80px;
}

.page-wrap {
  margin-top: 40px;
}

.container {
  width: 100%;
}

/* 💎 Sophisticated Glassmorphism */
.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-md);
}

.panel {
  padding: 28px;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm);
}

/* 🧭 Navigation Bar */
.topbar {
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 24px;
  z-index: 1000;
  border-radius: 20px;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 1.4rem;
  font-weight: 850;
  letter-spacing: -0.03em;
  color: var(--bg-dark);
}

.brand-dot {
  width: 14px;
  height: 14px;
  background: var(--primary);
  border-radius: 5px;
  box-shadow: 0 0 12px var(--primary-glow);
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(0, 166, 81, 0.5); }
  70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(0, 166, 81, 0); }
  100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(0, 166, 81, 0); }
}

.nav-links {
  display: flex;
  gap: 6px;
  background: rgba(0, 0, 0, 0.04);
  padding: 5px;
  border-radius: 16px;
}

.nav-links a {
  padding: 8px 18px;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-muted);
  transition: all 0.2s;
}

.nav-links a:hover {
  color: var(--text-main);
  background: rgba(255, 255, 255, 0.4);
}

.nav-links a.active {
  color: var(--primary);
  background: var(--bg-white);
  box-shadow: var(--shadow-sm);
}

.auth-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.user-badge {
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 6px 14px;
  border-radius: 20px;
}

/* 🔘 Modern Buttons */
.btn {
  border: none;
  border-radius: var(--radius-md);
  padding: 12px 24px;
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.btn-primary {
  background: var(--primary);
  color: white;
  box-shadow: 0 4px 14px var(--primary-glow);
}

.btn-primary:hover:not(:disabled) {
  transform: translateY(-2px);
  background: var(--primary-hover);
  box-shadow: 0 6px 20px var(--primary-glow);
}

.btn-ghost {
  background: var(--primary-soft);
  color: var(--primary);
  border: 1px solid transparent;
}

.btn-ghost:hover:not(:disabled) {
  background: white;
  border-color: var(--primary);
  box-shadow: var(--shadow-sm);
}

/* 📊 Page Elements */
.page-head {
  padding: 48px 32px;
  border-radius: var(--radius-xl);
  margin-bottom: 32px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-md);
}

.page-head h1 {
  font-size: 2.6rem;
  font-weight: 850;
  letter-spacing: -0.04em;
  color: var(--bg-dark);
  line-height: 1.1;
}

.page-head.centered {
  text-align: center;
  align-items: center;
}

.eyebrow {
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: var(--primary);
  text-transform: uppercase;
  margin-bottom: 4px;
  display: block;
}

.grid.two-col {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 32px;
}

/* 🗺️ Specialized Components */
.map-container {
  width: 100%;
  height: 520px;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--border-main);
  box-shadow: var(--shadow-lg);
}

.info-card {
  background: var(--bg-subtle);
  border-radius: var(--radius-lg);
  padding: 24px;
  border: 1px solid var(--border-main);
}

/* 📋 Lists & Tables */
.scroll-box {
  max-height: 540px;
  overflow-y: auto;
  padding: 4px;
}

.list-button {
  width: 100%;
  padding: 18px;
  text-align: left;
  background: var(--bg-white);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  color: var(--text-main);
  cursor: pointer;
  transition: all 0.2s ease;
  margin-bottom: 12px;
  box-shadow: var(--shadow-sm);
}

.list-button:hover {
  transform: translateX(4px);
  border-color: var(--primary);
}

.list-button.active {
  background: var(--primary-soft);
  border-color: var(--primary);
  box-shadow: 0 4px 12px var(--primary-glow);
}

.data-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 10px;
}

.data-table th {
  padding: 12px 20px;
  text-align: left;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.data-table td {
  padding: 20px;
  background: var(--bg-white);
  border-top: 1px solid var(--border-light);
  border-bottom: 1px solid var(--border-light);
}

.data-table td:first-child {
  border-left: 1px solid var(--border-light);
  border-top-left-radius: var(--radius-lg);
  border-bottom-left-radius: var(--radius-lg);
}

.data-table td:last-child {
  border-right: 1px solid var(--border-light);
  border-top-right-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
}

.badge {
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 0.8rem;
  font-weight: 800;
  background: var(--primary);
  color: white;
}

.muted {
  color: var(--text-muted);
}

/* 📱 Mobile Responsiveness */
@media (max-width: 1024px) {
  .grid.two-col {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .app-shell {
    padding: 16px 16px 80px;
  }

  .topbar {
    flex-direction: column;
    padding: 20px;
    gap: 16px;
    top: 16px;
    border-radius: 24px;
  }

  .nav-links {
    width: 100%;
    overflow-x: auto;
    justify-content: flex-start;
  }

  .page-head {
    padding: 32px 20px;
  }

  .page-head h1 {
    font-size: 2rem;
  }
}

/* 🎨 Custom Scrollbar */
::-webkit-scrollbar {
  width: 10px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--border-main);
  border-radius: 10px;
  border: 3px solid var(--bg-subtle);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--text-muted);
}
